# Supabase Configuration (Optional for Cloud Mode, not required for local offline mode)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# GitHub Pages Base Path
# When deploying to https://thecrazydabi.github.io/Portfolio/, set to /Portfolio/
# When deploying to a custom domain or Vercel, set to /
VITE_BASE_PATH=/Portfolio/
